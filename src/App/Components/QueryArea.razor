@using Lexql.Core.Relational
@using Lexql.Core.Relational.Dml
@using Lexql.Core.Relational.Sql
@using Lexql.Core.Results
@inject WorkspaceState Workspace
@inject LocalizationService L

<main class="editor-area">
    <div class="tab-strip">
        @foreach (var tab in Workspace.Tabs)
        {
            <div class="tab @(tab.Id == Workspace.ActiveTabId ? "active" : null)" @onclick="() => SwitchTabAsync(tab.Id)">
                <span>@tab.Title</span>
                <button class="btn-x" @onclick:stopPropagation="true" @onclick="() => Workspace.CloseTab(tab.Id)">×</button>
            </div>
        }
        <button class="tab-add" title="@L["query.newQuery"]" @onclick="() => Workspace.AddTab()"
                disabled="@(Workspace.Connections.Count == 0)">＋</button>
    </div>

    @if (Workspace.ActiveTab is { } active)
    {
        <section class="panel query-panel">
            <div class="query-head">
                <select class="conn-select" value="@active.ConnectionId" @onchange="e => SetConnection(active, e)">
                    <option value="">@L["query.noConnection"]</option>
                    @foreach (var server in Workspace.Connections)
                    {
                        <option value="@server.Id">@server.Name</option>
                    }
                </select>
                <span class="hint">@L["query.hint"]</span>
            </div>

            <SqlEditor @key="active.Id" @ref="_editor"
                       InitialValue="@active.Sql" OnRun="RunAsync" CompletionSource="GetCompletionsAsync" />

            <div class="query-actions">
                <button class="btn-run" @onclick="RunAsync" disabled="@(_running || ConnectionOf(active) is null)">
                    @(_running ? L["query.running"] : L["query.run"])
                </button>
                @if (_running)
                {
                    <button class="btn-stop" @onclick="Stop">@L["query.stop"]</button>
                }
                <label class="limit">@L["query.limit"] <input class="limit-input" type="number" min="1" @bind="active.RowLimit" /></label>
                @if (active.Status is not null)
                {
                    <span class="run-status">@active.Status</span>
                }
            </div>

            @if (active.Error is not null)
            {
                <p class="status error">@active.Error</p>
            }

            @if (active.Messages.Count > 0)
            {
                <ul class="message-panel">
                    @foreach (var message in active.Messages)
                    {
                        <li class="message @message.Severity.ToString().ToLowerInvariant()">
                            <span class="message-sev">@message.Severity</span> @message.Text
                        </li>
                    }
                </ul>
            }
        </section>

        <section class="panel result-panel">
            @if (active.Grid is not null)
            {
                @if (active.Editability is { IsEditable: true } editable)
                {
                    <div class="edit-toolbar">
                        <span class="edit-badge editable">✎ @editable.Table — key: @string.Join(", ", editable.KeyColumns)</span>
                        <button class="btn-sm" @onclick="() => _grid!.AddRowAsync()">@L["grid.addRow"]</button>
                        <button class="btn-sm" @onclick="() => _grid!.DeleteSelectedAsync()">@L["grid.deleteSelected"]</button>
                        <button class="btn-sm primary" @onclick="PrepareApplyAsync">@L["grid.preview"]</button>
                    </div>
                    <ResultGrid @ref="_grid" Model="active.Grid" Editable="true" KeyColumns="editable.KeyColumns" />
                }
                else
                {
                    @if (active.Editability is { } readOnly)
                    {
                        <p class="edit-badge readonly">Read-only — @readOnly.Reason</p>
                    }
                    <ResultGrid Model="active.Grid" />
                }
            }
            else
            {
                <p class="status muted">@L["query.runPrompt"]</p>
            }
        </section>

        @if (_previewSql is not null)
        {
            <div class="modal-overlay" @onclick="CancelApply">
                <div class="modal" @onclick:stopPropagation="true">
                    <h3>@L["grid.applyTitle"]</h3>
                    <pre class="preview-sql">@_previewSql</pre>
                    <div class="actions">
                        <button class="btn-run" @onclick="ConfirmApplyAsync" disabled="@_applying">
                            @(_applying ? L["grid.applying"] : L["grid.applyTx"])
                        </button>
                        <button class="btn-secondary" @onclick="CancelApply" disabled="@_applying">@L["conn.cancel"]</button>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <p class="status muted">@L["query.empty"]</p>
    }
</main>

@code {
    private SqlEditor? _editor;
    private ResultGrid? _grid;
    private bool _running;
    private CancellationTokenSource? _cts;

    private void Stop() => _cts?.Cancel();

    private string? _previewSql;
    private List<DmlCommand>? _pendingCommands;
    private bool _applying;

    private ServerConnection? ConnectionOf(QueryTab tab) => Workspace.ConnectionFor(tab);

    private async Task SwitchTabAsync(string id)
    {
        await SaveEditorAsync();
        Workspace.SetActiveTab(id);
    }

    private void SetConnection(QueryTab tab, ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        tab.ConnectionId = string.IsNullOrEmpty(value) ? null : value;
    }

    private async Task SaveEditorAsync()
    {
        if (_editor is not null && Workspace.ActiveTab is { } tab)
        {
            tab.Sql = await _editor.GetValueAsync();
        }
    }

    private async Task<IReadOnlyList<CompletionEntry>> GetCompletionsAsync(string text, int offset)
    {
        var connection = Workspace.ActiveTab is { } tab ? ConnectionOf(tab) : null;
        var provider = connection?.Connection.GetService<ISqlCompletionProvider>();
        if (provider is null)
        {
            return [];
        }

        var items = await provider.GetCompletionsAsync(text, offset, CancellationToken.None);
        return items.Select(i => new CompletionEntry(i.Label, i.Kind.ToString(), i.Detail)).ToList();
    }

    private async Task PrepareApplyAsync()
    {
        if (_grid is null || Workspace.ActiveTab is not { Editability: { IsEditable: true } editable })
        {
            return;
        }

        var changes = await _grid.GetChangesAsync();
        if (changes is null)
        {
            return;
        }

        var rowChanges = BuildRowChanges(changes, editable);
        _pendingCommands = DmlGenerator.Generate(rowChanges).ToList();
        _previewSql = _pendingCommands.Count == 0
            ? null
            : string.Join(";\n", _pendingCommands.Select(c => c.Sql)) + ";";
    }

    private async Task ConfirmApplyAsync()
    {
        var tab = Workspace.ActiveTab;
        var connection = tab is null ? null : ConnectionOf(tab);
        if (tab is null || connection is null || _pendingCommands is null)
        {
            return;
        }

        _applying = true;
        try
        {
            await DmlApplier.ApplyAsync(connection.Connection.QueryExecutor, _pendingCommands, CancellationToken.None);
            _previewSql = null;
            _pendingCommands = null;
            await RunAsync();
        }
        catch (QueryExecutionException ex)
        {
            tab.Error = ex.Message;
            _previewSql = null;
            _pendingCommands = null;
        }
        finally
        {
            _applying = false;
        }
    }

    private void CancelApply()
    {
        _previewSql = null;
        _pendingCommands = null;
    }

    private static List<RowChange> BuildRowChanges(GridChangeSet changes, EditabilityInfo editable)
    {
        var rowChanges = new List<RowChange>();

        foreach (var update in changes.Updates)
        {
            rowChanges.Add(new RowChange(
                RowChangeKind.Update, editable.Table!, Box(update.Values), Box(update.Key), editable.Schema));
        }

        foreach (var insert in changes.Inserts)
        {
            rowChanges.Add(new RowChange(
                RowChangeKind.Insert, editable.Table!, Box(insert.Values), new Dictionary<string, object?>(), editable.Schema));
        }

        foreach (var delete in changes.Deletes)
        {
            rowChanges.Add(new RowChange(
                RowChangeKind.Delete, editable.Table!, new Dictionary<string, object?>(), Box(delete.Key), editable.Schema));
        }

        return rowChanges;
    }

    private static Dictionary<string, object?> Box(Dictionary<string, string?> map) =>
        map.ToDictionary(kv => kv.Key, kv => (object?)kv.Value);

    private static async Task<EditabilityInfo?> AnalyzeEditabilityAsync(
        ServerConnection connection, string sql, ResultGridModel grid)
    {
        if (connection.DefaultNamespace is null)
        {
            return null;
        }

        var schemaReader = connection.Connection.GetService<IRelationalSchemaReader>();
        if (schemaReader is null)
        {
            return null;
        }

        try
        {
            var schema = await schemaReader.LoadAsync(connection.DefaultNamespace, CancellationToken.None);
            var columns = grid.Columns.Select(c => c.Name).ToList();
            return EditableResultAnalyzer.Analyze(sql, columns, schema);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            return null;
        }
    }

    private async Task<string> ResolveSqlAsync()
    {
        if (_editor is null)
        {
            return string.Empty;
        }

        var selected = await _editor.GetSelectedTextAsync();
        if (!string.IsNullOrWhiteSpace(selected))
        {
            return selected;
        }

        var full = await _editor.GetValueAsync();
        var offset = await _editor.GetCursorOffsetAsync();
        return MySqlStatementSplitter.StatementAt(full, offset) ?? full;
    }

    private async Task RunAsync()
    {
        if (Workspace.ActiveTab is not { } tab)
        {
            return;
        }

        var connection = ConnectionOf(tab);
        if (connection is null)
        {
            return;
        }

        await SaveEditorAsync();
        var sql = await ResolveSqlAsync();
        if (string.IsNullOrWhiteSpace(sql))
        {
            return;
        }

        _running = true;
        tab.Error = null;
        tab.Status = null;
        tab.Grid = null;
        tab.Editability = null;
        tab.Messages = [];
        _cts = new CancellationTokenSource();
        try
        {
            var request = new QueryRequest(sql, RowLimit: tab.RowLimit);
            var execution = await connection.Connection.QueryExecutor.ExecuteAsync(request, _cts.Token);
            tab.Messages = execution.Messages;

            var resultSet = execution.ResultSets.FirstOrDefault();
            if (resultSet is not null)
            {
                tab.Grid = await ResultGridBuilder.BuildAsync(resultSet, _cts.Token);
                tab.Status = $"{tab.Grid.Rows.Count} rows in {execution.Elapsed.TotalMilliseconds:F0} ms";
                tab.Editability = await AnalyzeEditabilityAsync(connection, sql, tab.Grid);
            }
            else
            {
                tab.Status = $"{execution.AffectedCount ?? 0} affected in {execution.Elapsed.TotalMilliseconds:F0} ms";
            }
        }
        catch (OperationCanceledException)
        {
            tab.Status = L["query.canceled"];
        }
        catch (QueryExecutionException ex)
        {
            tab.Error = FormatError(ex);
        }
        finally
        {
            _running = false;
            _cts?.Dispose();
            _cts = null;
        }
    }

    private static string FormatError(QueryExecutionException ex)
    {
        var prefix = (ex.Code, ex.SqlState) switch
        {
            ({ } code, { } state) => $"[{code}] ({state}) ",
            ({ } code, null) => $"[{code}] ",
            _ => string.Empty,
        };
        return prefix + ex.Message;
    }
}
