@using System.IO
@using Lexql.Core.History
@using Lexql.Core.Relational
@using Lexql.Core.Relational.Dml
@using Lexql.Core.Relational.Sql
@using Lexql.Core.Results
@inject WorkspaceState Workspace
@inject LocalizationService L
@inject IQueryHistoryStore History
@inject IFileDialog FileDialog
@implements IDisposable

<main class="editor-area">
    <div class="tab-strip">
        @foreach (var tab in Workspace.Tabs)
        {
            <div class="qtab @(tab.Id == Workspace.ActiveTabId ? "active" : null)" @onclick="() => SwitchAsync(tab.Id)">
                <span class="tab-title">@tab.Title@(tab.Dirty ? " •" : null)</span>
                <button class="tab-close" title="@L["query.close"]"
                        @onclick:stopPropagation="true" @onclick="() => RequestCloseAsync(tab.Id)">×</button>
            </div>
        }
        <button class="tab-add" title="@L["query.newQuery"]" @onclick="() => Workspace.AddTab()">＋</button>
        <span class="tab-strip-spacer"></span>
        @if (FileDialog.Supported)
        {
            <button class="btn-icon" title="@L["file.open"]" @onclick="OpenFileAsync">
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 4.5 H6.2 L7.7 6 H14 V12.5 H2 Z" /></svg>
            </button>
            <button class="btn-icon" title="@L["file.save"]" disabled="@(Workspace.ActiveTab is null)" @onclick="() => SaveTabAsync(Workspace.ActiveTab)">
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 2.5 H11 L13.5 5 V13.5 H3 Z" /><path d="M5 2.5 V6 H10 V2.5" /><rect x="5.5" y="9" width="5" height="3.5" /></svg>
            </button>
        }
    </div>

    @if (_showHistory)
    {
        <section class="panel history-panel">
            <h2>@L["history.title"]</h2>
            <input class="field-input" placeholder="@L["history.search"]"
                   @bind="_historySearch" @bind:event="oninput" @onkeyup="RefreshHistoryAsync" />
            <ul class="history-list">
                @foreach (var entry in _history)
                {
                    <li class="@(entry.Success ? null : "failed")" @onclick="() => LoadSqlAsync(entry.Sql)">@entry.Sql</li>
                }
                @if (_history.Count == 0)
                {
                    <li class="muted">@L["history.empty"]</li>
                }
            </ul>
            <div class="muted small">@L["history.saved"]</div>
            <ul class="history-list">
                @foreach (var saved in _saved)
                {
                    <li @onclick="() => LoadSqlAsync(saved.Sql)">@saved.Name</li>
                }
            </ul>
            <div class="save-row">
                <input class="field-input" placeholder="@L["history.saveName"]" @bind="_saveName" />
                <button class="btn-sm" @onclick="SaveCurrentAsync">@L["history.save"]</button>
            </div>
        </section>
    }

    @if (Workspace.ActiveTab is { } active)
    {
        <section class="panel query-panel">
            <div class="query-head">
                <select class="conn-select" value="@active.ConnectionId" @onchange="e => SetConnectionAsync(active, e)">
                    <option value="">@L["query.noConnection"]</option>
                    @foreach (var server in Workspace.Connections)
                    {
                        <option value="@server.Id">@server.Name</option>
                    }
                    @foreach (var profile in SavedNotConnected)
                    {
                        <option value="@("profile:" + profile.Name)">@profile.Name @L["query.connectSuffix"]</option>
                    }
                </select>
                @if (DatabasesOf(active).Any())
                {
                    <select class="conn-select db-select" value="@(active.Database ?? string.Empty)" @onchange="e => SetDatabase(active, e)">
                        <option value="">@L["query.database"]</option>
                        @foreach (var db in DatabasesOf(active))
                        {
                            <option value="@db">@db</option>
                        }
                    </select>
                }
                <span class="hint">@L["query.hint"]</span>
                <button class="icon-btn history-toggle" title="@L["history.title"]" @onclick="ToggleHistoryAsync">🕘</button>
            </div>

            <SqlEditor @key="active.Id" @ref="_editor"
                       InitialValue="@active.Sql" OnRun="RunCurrentAsync" OnRunAll="RunAllAsync"
                       OnChanged="MarkDirty" CompletionSource="GetCompletionsAsync" />

            <div class="query-actions">
                <button class="btn-run" title="F5" @onclick="RunAllAsync" disabled="@(_running || ConnectionOf(active) is null)">
                    @(_running ? L["query.running"] : L["query.runAll"])
                </button>
                <button class="btn-run secondary" title="F8" @onclick="RunCurrentAsync" disabled="@(_running || ConnectionOf(active) is null)">
                    @L["query.run"]
                </button>
                @if (_running)
                {
                    <button class="btn-stop" @onclick="Stop">@L["query.stop"]</button>
                }
                <label class="limit">@L["query.limit"] <input class="limit-input" type="number" min="1" @bind="active.RowLimit" /></label>
                @if (active.Status is not null)
                {
                    <span class="run-status">@active.Status</span>
                }
            </div>

            @if (active.Error is not null)
            {
                <p class="status error">@active.Error</p>
            }

            @if (active.Messages.Count > 0)
            {
                <ul class="message-panel">
                    @foreach (var message in active.Messages)
                    {
                        <li class="message @message.Severity.ToString().ToLowerInvariant()">
                            <span class="message-sev">@message.Severity</span> @message.Text
                        </li>
                    }
                </ul>
            }
        </section>

        <section class="panel result-panel">
            @if (active.Grid is not null)
            {
                @if (active.Editability is { IsEditable: true } editable)
                {
                    <div class="edit-toolbar">
                        <span class="edit-badge editable">✎ @editable.Table — key: @string.Join(", ", editable.KeyColumns)</span>
                        <button class="btn-sm" @onclick="() => _grid!.AddRowAsync()">@L["grid.addRow"]</button>
                        <button class="btn-sm" @onclick="() => _grid!.DeleteSelectedAsync()">@L["grid.deleteSelected"]</button>
                        <button class="btn-sm primary" @onclick="PrepareApplyAsync">@L["grid.preview"]</button>
                    </div>
                    <ResultGrid @ref="_grid" Model="active.Grid" Editable="true" KeyColumns="editable.KeyColumns" />
                }
                else
                {
                    @if (active.Editability is { } readOnly)
                    {
                        <p class="edit-badge readonly">Read-only — @readOnly.Reason</p>
                    }
                    <ResultGrid Model="active.Grid" />
                }
            }
            else
            {
                <p class="status muted">@L["query.runPrompt"]</p>
            }
        </section>

        @if (_previewSql is not null)
        {
            <div class="modal-overlay" @onclick="CancelApply">
                <div class="lx-modal" @onclick:stopPropagation="true">
                    <h3>@L["grid.applyTitle"]</h3>
                    <pre class="preview-sql">@_previewSql</pre>
                    <div class="actions">
                        <button class="btn-run" @onclick="ConfirmApplyAsync" disabled="@_applying">
                            @(_applying ? L["grid.applying"] : L["grid.applyTx"])
                        </button>
                        <button class="btn-secondary" @onclick="CancelApply" disabled="@_applying">@L["conn.cancel"]</button>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="empty-state">
            <div class="empty-glyph">&gt;_</div>
            <p>@L["query.empty"]</p>
            <button class="btn-add-server" @onclick="() => Workspace.AddTab()">＋ @L["query.newQuery"]</button>
        </div>
    }

    @if (_closingTab is { } closing)
    {
        <div class="modal-overlay" @onclick="CancelClose">
            <div class="lx-modal close-modal" @onclick:stopPropagation="true">
                <h3>@L["close.title"]</h3>
                <p>@string.Format(L["close.message"], closing.Title)</p>
                <div class="actions">
                    <button class="btn-secondary" @onclick="DiscardAndClose" disabled="@_closingBusy">@L["close.dontSave"]</button>
                    <span class="spacer"></span>
                    <button class="btn-secondary" @onclick="CancelClose" disabled="@_closingBusy">@L["conn.cancel"]</button>
                    <button class="btn-connect" @onclick="SaveAndCloseAsync" disabled="@_closingBusy">@L["close.save"]</button>
                </div>
            </div>
        </div>
    }
</main>

@code {
    private SqlEditor? _editor;
    private ResultGrid? _grid;
    private bool _running;
    private CancellationTokenSource? _cts;

    private bool _showHistory;
    private string? _historySearch;
    private string _saveName = string.Empty;
    private IReadOnlyList<QueryHistoryEntry> _history = [];
    private IReadOnlyList<SavedQuery> _saved = [];

    protected override void OnInitialized()
    {
        Workspace.FlushActiveTab = SaveEditorAsync;
        Workspace.Changed += OnChanged;
        L.Changed += OnChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        if (Workspace.FlushActiveTab == SaveEditorAsync)
        {
            Workspace.FlushActiveTab = null;
        }

        Workspace.Changed -= OnChanged;
        L.Changed -= OnChanged;
    }

    private void Stop() => _cts?.Cancel();

    private async Task ToggleHistoryAsync()
    {
        _showHistory = !_showHistory;
        if (_showHistory)
        {
            await RefreshHistoryAsync();
        }
    }

    private async Task RefreshHistoryAsync()
    {
        var search = string.IsNullOrWhiteSpace(_historySearch) ? null : _historySearch;
        _history = await History.SearchHistoryAsync(search, 50, CancellationToken.None);
        _saved = await History.ListSavedAsync(CancellationToken.None);
    }

    private async Task LoadSqlAsync(string sql)
    {
        if (Workspace.ActiveTab is { } tab)
        {
            tab.Sql = sql;
            if (_editor is not null)
            {
                await _editor.SetValueAsync(sql);
            }
        }
    }

    private async Task SaveCurrentAsync()
    {
        if (string.IsNullOrWhiteSpace(_saveName) || _editor is null)
        {
            return;
        }

        await History.SaveQueryAsync(_saveName, await _editor.GetValueAsync(), CancellationToken.None);
        _saveName = string.Empty;
        await RefreshHistoryAsync();
    }

    private string? _previewSql;
    private List<DmlCommand>? _pendingCommands;
    private bool _applying;

    private ServerConnection? ConnectionOf(QueryTab tab) => Workspace.ConnectionFor(tab);

    private Task SwitchAsync(string id) => Workspace.SwitchTabAsync(id);

    private IEnumerable<ConnectionProfile> SavedNotConnected =>
        Workspace.SavedProfiles.Where(p => !Workspace.Connections.Any(c => c.Name == p.Name));

    private async Task SetConnectionAsync(QueryTab tab, ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        if (string.IsNullOrEmpty(value))
        {
            tab.ConnectionId = null;
            tab.Database = null;
            return;
        }

        if (value.StartsWith("profile:", StringComparison.Ordinal))
        {
            var name = value["profile:".Length..];
            var profile = Workspace.SavedProfiles.FirstOrDefault(p => p.Name == name);
            if (profile is null)
            {
                return;
            }

            var connection = Workspace.Connections.FirstOrDefault(c => c.Name == name);
            if (connection is null)
            {
                if (!await Workspace.ConnectAsync(profile))
                {
                    return;
                }

                connection = Workspace.Connections.FirstOrDefault(c => c.Name == name);
            }

            tab.ConnectionId = connection?.Id;
        }
        else
        {
            tab.ConnectionId = value;
        }

        tab.Database = ConnectionOf(tab)?.DefaultNamespace;
    }

    private void MarkDirty()
    {
        if (Workspace.ActiveTab is { Dirty: false } tab)
        {
            tab.Dirty = true;
            StateHasChanged();
        }
    }

    private async Task OpenFileAsync()
    {
        var pick = await FileDialog.OpenAsync();
        if (pick is not null)
        {
            Workspace.OpenFileTab(pick.Path, pick.Content);
        }
    }

    private async Task SaveTabAsync(QueryTab? tab)
    {
        if (tab is null)
        {
            return;
        }

        if (tab.Id == Workspace.ActiveTabId)
        {
            await SaveEditorAsync();
        }

        if (tab.FilePath is { } path)
        {
            await File.WriteAllTextAsync(path, tab.Sql);
            tab.Dirty = false;
        }
        else
        {
            var saved = await FileDialog.SaveAsync($"{tab.Title}.sql", tab.Sql);
            if (saved is not null)
            {
                tab.FilePath = saved;
                tab.Title = Path.GetFileName(saved);
                tab.Dirty = false;
            }
        }
    }

    private QueryTab? _closingTab;
    private bool _closingBusy;

    private async Task RequestCloseAsync(string tabId)
    {
        var tab = Workspace.Tabs.FirstOrDefault(t => t.Id == tabId);
        if (tab is null)
        {
            return;
        }

        if (tab.Id == Workspace.ActiveTabId)
        {
            await SaveEditorAsync();
        }

        if (tab.Dirty && !string.IsNullOrWhiteSpace(tab.Sql))
        {
            _closingTab = tab;
            return;
        }

        Workspace.CloseTab(tabId);
    }

    private void CancelClose() => _closingTab = null;

    private void DiscardAndClose()
    {
        if (_closingTab is { } tab)
        {
            Workspace.CloseTab(tab.Id);
            _closingTab = null;
        }
    }

    private async Task SaveAndCloseAsync()
    {
        if (_closingTab is not { } tab)
        {
            return;
        }

        _closingBusy = true;
        try
        {
            await SaveTabAsync(tab);
            if (!tab.Dirty)
            {
                Workspace.CloseTab(tab.Id);
                _closingTab = null;
            }
        }
        finally
        {
            _closingBusy = false;
        }
    }

    private void SetDatabase(QueryTab tab, ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        tab.Database = string.IsNullOrEmpty(value) ? null : value;
    }

    private IEnumerable<string> DatabasesOf(QueryTab tab) =>
        ConnectionOf(tab) is { } connection
            ? connection.Roots.Where(r => r.Kind == DatabaseObjectKind.Namespace).Select(r => r.Name)
            : [];

    private async Task SaveEditorAsync()
    {
        if (_editor is not null && Workspace.ActiveTab is { } tab)
        {
            tab.Sql = await _editor.GetValueAsync();
        }
    }

    private async Task<IReadOnlyList<CompletionEntry>> GetCompletionsAsync(string text, int offset)
    {
        var connection = Workspace.ActiveTab is { } tab ? ConnectionOf(tab) : null;
        var provider = connection?.Connection.GetService<ISqlCompletionProvider>();
        if (provider is null)
        {
            return [];
        }

        var items = await provider.GetCompletionsAsync(text, offset, CancellationToken.None);
        return items.Select(i => new CompletionEntry(i.Label, i.Kind.ToString(), i.Detail)).ToList();
    }

    private async Task PrepareApplyAsync()
    {
        if (_grid is null || Workspace.ActiveTab is not { Editability: { IsEditable: true } editable })
        {
            return;
        }

        var changes = await _grid.GetChangesAsync();
        if (changes is null)
        {
            return;
        }

        var rowChanges = BuildRowChanges(changes, editable);
        _pendingCommands = DmlGenerator.Generate(rowChanges).ToList();
        _previewSql = _pendingCommands.Count == 0
            ? null
            : string.Join(";\n", _pendingCommands.Select(c => c.Sql)) + ";";
    }

    private async Task ConfirmApplyAsync()
    {
        var tab = Workspace.ActiveTab;
        var connection = tab is null ? null : ConnectionOf(tab);
        if (tab is null || connection is null || _pendingCommands is null)
        {
            return;
        }

        _applying = true;
        try
        {
            await DmlApplier.ApplyAsync(connection.Connection.QueryExecutor, _pendingCommands, CancellationToken.None);
            _previewSql = null;
            _pendingCommands = null;
            await RunAsync();
        }
        catch (QueryExecutionException ex)
        {
            tab.Error = ex.Message;
            _previewSql = null;
            _pendingCommands = null;
        }
        finally
        {
            _applying = false;
        }
    }

    private void CancelApply()
    {
        _previewSql = null;
        _pendingCommands = null;
    }

    private static List<RowChange> BuildRowChanges(GridChangeSet changes, EditabilityInfo editable)
    {
        var rowChanges = new List<RowChange>();

        foreach (var update in changes.Updates)
        {
            rowChanges.Add(new RowChange(
                RowChangeKind.Update, editable.Table!, Box(update.Values), Box(update.Key), editable.Schema));
        }

        foreach (var insert in changes.Inserts)
        {
            rowChanges.Add(new RowChange(
                RowChangeKind.Insert, editable.Table!, Box(insert.Values), new Dictionary<string, object?>(), editable.Schema));
        }

        foreach (var delete in changes.Deletes)
        {
            rowChanges.Add(new RowChange(
                RowChangeKind.Delete, editable.Table!, new Dictionary<string, object?>(), Box(delete.Key), editable.Schema));
        }

        return rowChanges;
    }

    private static Dictionary<string, object?> Box(Dictionary<string, string?> map) =>
        map.ToDictionary(kv => kv.Key, kv => (object?)kv.Value);

    private static async Task<EditabilityInfo?> AnalyzeEditabilityAsync(
        ServerConnection connection, string? namespaceName, string sql, ResultGridModel grid)
    {
        if (string.IsNullOrWhiteSpace(namespaceName))
        {
            return null;
        }

        var schemaReader = connection.Connection.GetService<IRelationalSchemaReader>();
        if (schemaReader is null)
        {
            return null;
        }

        try
        {
            var schema = await schemaReader.LoadAsync(namespaceName, CancellationToken.None);
            var columns = grid.Columns.Select(c => c.Name).ToList();
            return EditableResultAnalyzer.Analyze(sql, columns, schema);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            return null;
        }
    }

    private async Task<string> ResolveSqlAsync()
    {
        if (_editor is null)
        {
            return string.Empty;
        }

        var selected = await _editor.GetSelectedTextAsync();
        if (!string.IsNullOrWhiteSpace(selected))
        {
            return selected;
        }

        var full = await _editor.GetValueAsync();
        var offset = await _editor.GetCursorOffsetAsync();
        return MySqlStatementSplitter.StatementAt(full, offset) ?? full;
    }

    private Task RunAllAsync() => RunAsync(currentStatementOnly: false);

    private Task RunCurrentAsync() => RunAsync(currentStatementOnly: true);

    private async Task RunAsync(bool currentStatementOnly = true)
    {
        if (Workspace.ActiveTab is not { } tab)
        {
            return;
        }

        var connection = ConnectionOf(tab);
        if (connection is null)
        {
            return;
        }

        await SaveEditorAsync();
        var sql = currentStatementOnly
            ? await ResolveSqlAsync()
            : (_editor is null ? string.Empty : await _editor.GetValueAsync());
        if (string.IsNullOrWhiteSpace(sql))
        {
            return;
        }

        _running = true;
        tab.Error = null;
        tab.Status = null;
        tab.Grid = null;
        tab.Editability = null;
        tab.Messages = [];
        _cts = new CancellationTokenSource();
        try
        {
            var targetDatabase = tab.Database ?? connection.DefaultNamespace;
            var text = string.IsNullOrWhiteSpace(targetDatabase)
                ? sql
                : $"USE `{targetDatabase.Replace("`", "``")}`;\n{sql}";

            var request = new QueryRequest(text, RowLimit: tab.RowLimit);
            var execution = await connection.Connection.QueryExecutor.ExecuteAsync(request, _cts.Token);
            tab.Messages = execution.Messages;

            var resultSet = execution.ResultSets.FirstOrDefault();
            if (resultSet is not null)
            {
                tab.Grid = await ResultGridBuilder.BuildAsync(resultSet, _cts.Token);
                tab.Status = $"{tab.Grid.Rows.Count} rows in {execution.Elapsed.TotalMilliseconds:F0} ms";
                tab.Editability = await AnalyzeEditabilityAsync(connection, targetDatabase, sql, tab.Grid);
            }
            else
            {
                tab.Status = $"{execution.AffectedCount ?? 0} affected in {execution.Elapsed.TotalMilliseconds:F0} ms";
            }

            await History.AddHistoryAsync(sql, connection.Name, true, CancellationToken.None);
        }
        catch (OperationCanceledException)
        {
            tab.Status = L["query.canceled"];
        }
        catch (QueryExecutionException ex)
        {
            tab.Error = FormatError(ex);
            await History.AddHistoryAsync(sql, connection.Name, false, CancellationToken.None);
        }
        finally
        {
            _running = false;
            _cts?.Dispose();
            _cts = null;
        }
    }

    private static string FormatError(QueryExecutionException ex)
    {
        var prefix = (ex.Code, ex.SqlState) switch
        {
            ({ } code, { } state) => $"[{code}] ({state}) ",
            ({ } code, null) => $"[{code}] ",
            _ => string.Empty,
        };
        return prefix + ex.Message;
    }
}
