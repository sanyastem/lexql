@inject WorkspaceState Workspace
@inject LocalizationService L
@implements IDisposable

<div class="modal-overlay" @onclick="Cancel">
    <div class="modal connect-modal" @onclick:stopPropagation="true">
        <h3>@(Template is null ? L["conn.newConnection"] : Template.Name)</h3>

        <div class="fields">
            <label class="field">
                <span class="field-label">@L["conn.name"]</span>
                <input class="field-input" @bind="_name" placeholder="@L["conn.namePlaceholder"]" />
            </label>

            @foreach (var field in BasicFields)
            {
                <ConnectionFieldEditor Field="field" Values="_values" />
            }
        </div>

        <div class="field-inline-row">
            <label class="field-inline">
                <input type="checkbox" @bind="_readOnly" /> @L["conn.readOnly"]
            </label>
            <label class="field-inline">
                @L["conn.rowLimit"]
                <input class="field-input limit-input" type="number" min="1" @bind="_rowLimit" />
            </label>
        </div>

        @if (AdvancedFields.Any())
        {
            <details class="advanced">
                <summary>@L["conn.advanced"]</summary>
                <div class="fields">
                    @foreach (var field in AdvancedFields)
                    {
                        <ConnectionFieldEditor Field="field" Values="_values" />
                    }
                </div>
            </details>
        }

        @if (Workspace.LastError is not null)
        {
            <p class="status error">@Workspace.LastError</p>
        }

        <div class="actions">
            <label class="field-inline save-toggle">
                <input type="checkbox" @bind="_save" /> @L["conn.save"]
            </label>
            <span class="spacer"></span>
            <button class="btn-secondary" @onclick="Cancel" disabled="@_busy">@L["conn.cancel"]</button>
            <button class="btn-connect" @onclick="ConnectAsync" disabled="@_busy">
                @(_busy ? L["conn.connecting"] : L["conn.connect"])
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public EventCallback OnDone { get; set; }

    [Parameter]
    public ConnectionProfile? Template { get; set; }

    private readonly Dictionary<string, string?> _values = new();
    private string _name = string.Empty;
    private bool _save;
    private bool _readOnly;
    private int? _rowLimit;
    private bool _busy;

    protected override void OnInitialized()
    {
        foreach (var field in Workspace.Fields)
        {
            _values[field.Key] = Template is not null && Template.Settings.TryGetValue(field.Key, out var value)
                ? value
                : field.Default;
        }

        _name = Template?.Name ?? string.Empty;
        _readOnly = Template?.ReadOnly ?? false;
        _rowLimit = Template?.DefaultRowLimit;
        _save = true;
        L.Changed += OnChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => L.Changed -= OnChanged;

    private IEnumerable<ConnectionField> BasicFields => Workspace.Fields.Where(f => !f.Advanced);

    private IEnumerable<ConnectionField> AdvancedFields => Workspace.Fields.Where(f => f.Advanced);

    private async Task ConnectAsync()
    {
        _busy = true;
        try
        {
            string name;
            if (!string.IsNullOrWhiteSpace(_name))
            {
                name = _name.Trim();
            }
            else if (_values.TryGetValue("host", out var host) && !string.IsNullOrWhiteSpace(host))
            {
                name = host;
            }
            else
            {
                name = Workspace.ProviderId;
            }
            var profile = new ConnectionProfile(
                Workspace.ProviderId, name, new Dictionary<string, string?>(_values),
                ReadOnly: _readOnly, DefaultRowLimit: _rowLimit);

            if (_save)
            {
                await Workspace.SaveProfileAsync(profile);
            }

            if (await Workspace.ConnectAsync(profile))
            {
                await OnDone.InvokeAsync();
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private Task Cancel() => OnDone.InvokeAsync();
}
