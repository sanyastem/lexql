@inject WorkspaceState Workspace
@inject LocalizationService L
@implements IDisposable

<div class="server @(IsActive ? "active" : null)">
    <div class="server-head" @onclick="ToggleAsync" @oncontextmenu="OpenMenu" @oncontextmenu:preventDefault="true">
        <span class="server-main">
            <span class="tree-chevron">@(Expanded ? "▾" : "▸")</span>
            <span class="tree-icon accent"><TreeIcon Kind="server" /></span>
            <span class="status-dot @(Connection is null ? "offline" : "online")" title="@(Connection is null ? L["conn.offline"] : L["conn.online"])"></span>
            <span class="server-name">@Name</span>
            @if (_connecting || _refreshing)
            {
                <span class="tree-loading">…</span>
            }
        </span>
        @if (Connection is { Connection.IsReadOnly: true })
        {
            <span class="ro-badge" title="Read-only">RO</span>
        }
    </div>

    @if (Connection is { } c)
    {
        @if (GlobalFilter && IsActive)
        {
            <ul class="tree-root filter-results">
                @if (_indexLoading)
                {
                    <li class="filter-note">@L["tree.loading"]</li>
                }
                else if (!Matches(c).Any())
                {
                    <li class="filter-note">@L["palette.empty"]</li>
                }
                else
                {
                    @foreach (var m in Matches(c))
                    {
                        <li class="tree-node">
                            <span class="tree-label data" @onclick="() => OpenDataAsync(c, new ObjectRef(m.Schema, m.Name))">
                                <span class="tree-chevron"></span>
                                <span class="tree-icon @(m.IsView ? null : "accent")"><TreeIcon Kind="@(m.IsView ? "view" : "container")" /></span>
                                <span class="tree-name">@m.Name</span>
                                <span class="filter-schema">@m.Schema</span>
                            </span>
                        </li>
                    }
                }
            </ul>
        }
        else if (!GlobalFilter && _expanded)
        {
            <ul class="tree-root">
                @foreach (var root in c.Roots)
                {
                    <ObjectTreeNode @key="@($"{root.Id}:{c.RefreshToken}")" Node="root" Explorer="c.Connection.ObjectExplorer"
                                    OnOpenData="t => OpenDataAsync(c, t)" />
                }
            </ul>
        }
    }

    @if (_error is not null)
    {
        <div class="server-error">@_error</div>
    }
</div>

@if (_menuOpen)
{
    <div class="context-overlay" @onclick="CloseMenu" @oncontextmenu:preventDefault="true" @oncontextmenu="CloseMenu"></div>
    <div class="context-menu" style="left:@(_menuX)px; top:@(_menuY)px">
        @if (Connection is { } conn)
        {
            <button class="ctx-item" @onclick="() => RefreshAsync(conn.Id)">@L["conn.refresh"]</button>
            <button class="ctx-item" @onclick="() => DisconnectAsync(conn.Id)">@L["conn.disconnect"]</button>
            <div class="ctx-sep"></div>
            <button class="ctx-item" @onclick="ShowPropertiesAsync">@L["conn.properties"]</button>
        }
        else
        {
            <button class="ctx-item" @onclick="ConnectFromMenuAsync" disabled="@(Profile is null)">@L["conn.connect"]</button>
        }

        @if (Profile is not null)
        {
            <div class="ctx-sep"></div>
            <button class="ctx-item" @onclick="EditFromMenu">@L["conn.edit"]</button>
        }
    </div>
}

@if (_showProps)
{
    <div class="modal-overlay" @onclick="CloseProperties">
        <div class="lx-modal props-modal" @onclick:stopPropagation="true">
            <h3>@Name — @L["conn.properties"]</h3>
            @if (_propsLoading)
            {
                <p class="status muted">@L["tree.loading"]</p>
            }
            else if (_propsError is not null)
            {
                <p class="status error">@_propsError</p>
            }
            else
            {
                <table class="props-table">
                    <tbody>
                        @foreach (var item in _serverInfo)
                        {
                            <tr>
                                <th>@item.Label</th>
                                <td>@item.Value</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            <div class="actions">
                <span class="spacer"></span>
                <button class="btn-secondary" @onclick="CloseProperties">@L["conn.close"]</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;

    [Parameter]
    public ConnectionProfile? Profile { get; set; }

    [Parameter]
    public EventCallback<ConnectionProfile> OnEdit { get; set; }

    private bool _expanded;
    private bool _connecting;
    private bool _refreshing;
    private string? _error;

    private bool _menuOpen;
    private double _menuX;
    private double _menuY;

    private bool _showProps;
    private bool _propsLoading;
    private string? _propsError;
    private IReadOnlyList<ServerInfoItem> _serverInfo = [];

    private ServerConnection? Connection => Workspace.Connections.FirstOrDefault(c => c.Name == Name);

    private bool IsActive => Connection is { } c && c.Id == Workspace.ActiveConnectionId;

    private bool Expanded => _expanded && (Connection is not null || _connecting);

    protected override void OnInitialized() => Workspace.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Workspace.Changed -= OnChanged;

    private async Task ToggleAsync()
    {
        _error = null;

        if (Connection is { } existing)
        {
            Workspace.SetActiveConnection(existing.Id);
            _expanded = !_expanded;
            return;
        }

        await ConnectAsync();
    }

    private async Task ConnectAsync()
    {
        if (Profile is null)
        {
            return;
        }

        _error = null;
        _expanded = true;
        _connecting = true;
        var connected = await Workspace.ConnectAsync(Profile);
        _connecting = false;

        if (!connected)
        {
            _expanded = false;
            _error = Workspace.LastError;
        }
    }

    private async Task RefreshAsync(string id)
    {
        CloseMenu();
        _refreshing = true;
        try
        {
            await Workspace.RefreshConnectionAsync(id);
        }
        finally
        {
            _refreshing = false;
        }
    }

    private void OpenMenu(MouseEventArgs e)
    {
        if (Connection is { } existing)
        {
            Workspace.SetActiveConnection(existing.Id);
        }

        _menuX = e.ClientX;
        _menuY = e.ClientY;
        _menuOpen = true;
    }

    private void CloseMenu() => _menuOpen = false;

    private async Task ConnectFromMenuAsync()
    {
        CloseMenu();
        await ConnectAsync();
    }

    private void EditFromMenu()
    {
        CloseMenu();
        if (Profile is not null)
        {
            OnEdit.InvokeAsync(Profile);
        }
    }

    private async Task DisconnectAsync(string id)
    {
        CloseMenu();
        await Workspace.DisconnectAsync(id);
    }

    private async Task ShowPropertiesAsync()
    {
        CloseMenu();
        if (Connection is not { } conn)
        {
            return;
        }

        _showProps = true;
        _propsLoading = true;
        _propsError = null;
        _serverInfo = [];

        try
        {
            _serverInfo = await Workspace.GetServerInfoAsync(conn.Id, CancellationToken.None);
        }
        catch (Exception ex)
        {
            _propsError = ex.Message;
        }
        finally
        {
            _propsLoading = false;
        }
    }

    private void CloseProperties() => _showProps = false;

    private void OpenDataAsync(ServerConnection connection, ObjectRef target)
    {
        Workspace.SetActiveConnection(connection.Id);
        Workspace.OpenTableData(connection.Id, target.Namespace, target.Name);
    }

    private bool _indexLoading;
    private string? _indexKey;
    private IReadOnlyList<ObjectIndexItem> _index = [];

    private bool GlobalFilter => !string.IsNullOrWhiteSpace(Workspace.TreeFilter);

    private IEnumerable<ObjectIndexItem> Matches(ServerConnection connection)
    {
        var filter = Workspace.TreeFilter;
        return _index
            .Where(o => o.Name.Contains(filter, StringComparison.OrdinalIgnoreCase)
                        || o.Schema.Contains(filter, StringComparison.OrdinalIgnoreCase))
            .Take(100);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!GlobalFilter || !IsActive || _indexLoading || Connection is not { } c)
        {
            return;
        }

        var key = $"{c.Id}:{c.RefreshToken}";
        if (_indexKey == key)
        {
            return;
        }

        _indexLoading = true;
        _indexKey = key;
        try
        {
            _index = await Workspace.GetObjectIndexAsync(c.Id, CancellationToken.None);
        }
        finally
        {
            _indexLoading = false;
        }

        StateHasChanged();
    }
}
