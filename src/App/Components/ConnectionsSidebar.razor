@inject WorkspaceState Workspace
@inject LocalizationService L

<aside class="sidebar">
    <div class="sidebar-header">
        <span>@L["app.servers"]</span>
        <div class="header-actions">
            <select class="lang-select" value="@L.CurrentLanguage" @onchange="OnLanguageChanged">
                @foreach (var language in L.Languages)
                {
                    <option value="@language.Code">@language.Name</option>
                }
            </select>
            <button class="btn-add" title="@L["conn.newConnection"]" @onclick="ShowNewForm">＋</button>
        </div>
    </div>

    @if (_showForm)
    {
        <ConnectForm @key="FormKey" Template="_template" OnDone="HideForm" />
    }

    @if (Workspace.SavedProfiles.Count > 0)
    {
        <div class="saved">
            <div class="muted small">@L["app.saved"]</div>
            @foreach (var profile in Workspace.SavedProfiles)
            {
                <button class="profile" @onclick="() => OpenTemplate(profile)">@profile.Name</button>
            }
        </div>
    }

    <div class="servers">
        @if (Workspace.Connections.Count == 0)
        {
            <p class="muted small">@L["app.noConnections"]</p>
        }
        @foreach (var server in Workspace.Connections)
        {
            <div class="server @(server.Id == Workspace.ActiveConnectionId ? "active" : null)">
                <div class="server-head" @onclick="() => Workspace.SetActiveConnection(server.Id)">
                    <span class="server-name">
                        @server.Name
                        @if (server.Connection.IsReadOnly)
                        {
                            <span class="ro-badge" title="Read-only">RO</span>
                        }
                    </span>
                    <button class="btn-x" title="@L["conn.disconnect"]"
                            @onclick:stopPropagation="true"
                            @onclick="() => Workspace.DisconnectAsync(server.Id)">×</button>
                </div>
                <ul class="tree-root">
                    @foreach (var root in server.Roots)
                    {
                        <ObjectTreeNode Node="root" Explorer="server.Connection.ObjectExplorer" />
                    }
                </ul>
            </div>
        }
    </div>
</aside>

@code {
    private bool _showForm;
    private ConnectionProfile? _template;

    private string FormKey => _template?.Name ?? "new";

    protected override void OnInitialized()
    {
        _showForm = Workspace.Connections.Count == 0 && Workspace.SavedProfiles.Count == 0;
    }

    private void ShowNewForm()
    {
        _template = null;
        _showForm = true;
    }

    private void OpenTemplate(ConnectionProfile profile)
    {
        _template = profile;
        _showForm = true;
    }

    private void HideForm() => _showForm = false;

    private void OnLanguageChanged(ChangeEventArgs e) => L.SetLanguage(e.Value?.ToString() ?? "en");
}
