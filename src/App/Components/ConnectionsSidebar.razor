@inject WorkspaceState Workspace
@inject LocalizationService L
@implements IDisposable

<aside class="sidebar">
    <div class="sidebar-header">
        <span class="sidebar-title">
            <span class="tree-icon accent"><TreeIcon Kind="server" /></span>
            @L["app.servers"]
        </span>
        <div class="header-actions">
            <button class="btn-icon" title="@L["conn.refresh"]" disabled="@_refreshing" @onclick="RefreshAllAsync">
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M12.5 8 a4.5 4.5 0 1 1 -1.3 -3.2" /><path d="M12.8 2.6 V5.2 H10.2" /></svg>
            </button>
            <button class="btn-add" title="@L["conn.newConnection"]" @onclick="ShowNewForm">＋</button>
        </div>
    </div>

    @if (_showForm)
    {
        <ConnectForm @key="FormKey" Template="_template" OnDone="HideForm" />
    }

    @if (Workspace.Connections.Count > 0)
    {
        <div class="tree-filter">
            <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="4.2" /><path d="M10.2 10.2 L13.5 13.5" /></svg>
            <input class="tree-filter-input" placeholder="@L["tree.filter"]"
                   value="@Workspace.TreeFilter" @oninput="e => Workspace.SetTreeFilter(e.Value?.ToString())" />
            @if (!string.IsNullOrEmpty(Workspace.TreeFilter))
            {
                <button class="tree-filter-clear" @onclick="() => Workspace.SetTreeFilter(string.Empty)">×</button>
            }
        </div>
    }

    <div class="servers">
        @if (Workspace.SavedProfiles.Count == 0 && Workspace.Connections.Count == 0)
        {
            <div class="sidebar-empty">
                <p>@L["conn.addHint"]</p>
                <button class="btn-add-server" @onclick="ShowNewForm">＋ @L["conn.addServer"]</button>
            </div>
        }

        <CascadingValue Value="Workspace.TreeFilter" Name="TreeFilter">
            @foreach (var profile in Workspace.SavedProfiles)
            {
                <ServerNode @key="@("p:" + profile.Name)" Name="@profile.Name" Profile="profile" OnEdit="OpenTemplate" />
            }

            @foreach (var server in AdHocConnections)
            {
                <ServerNode @key="@("c:" + server.Id)" Name="@server.Name" />
            }
        </CascadingValue>
    </div>
</aside>

@code {
    private bool _showForm;
    private bool _refreshing;
    private ConnectionProfile? _template;

    private string FormKey => _template?.Name ?? "new";

    private IEnumerable<ServerConnection> AdHocConnections =>
        Workspace.Connections.Where(c => !Workspace.SavedProfiles.Any(p => p.Name == c.Name));

    protected override void OnInitialized()
    {
        Workspace.Changed += OnChanged;
        L.Changed += OnChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Workspace.Changed -= OnChanged;
        L.Changed -= OnChanged;
    }

    private void ShowNewForm()
    {
        _template = null;
        _showForm = true;
    }

    private void OpenTemplate(ConnectionProfile profile)
    {
        _template = profile;
        _showForm = true;
    }

    private void HideForm() => _showForm = false;

    private async Task RefreshAllAsync()
    {
        _refreshing = true;
        try
        {
            await Workspace.RefreshAllAsync();
        }
        finally
        {
            _refreshing = false;
        }
    }
}
