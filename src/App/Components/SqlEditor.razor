@inject IJSRuntime JS
@inject ThemeState Theme
@implements IAsyncDisposable

<div @ref="_host" class="sql-editor-host"></div>

@code {
    [Parameter]
    public string InitialValue { get; set; } = string.Empty;

    [Parameter]
    public EventCallback OnRun { get; set; }

    [Parameter]
    public EventCallback OnRunAll { get; set; }

    [Parameter]
    public EventCallback OnChanged { get; set; }

    [Parameter]
    public Func<string, int, Task<IReadOnlyList<CompletionEntry>>>? CompletionSource { get; set; }

    private ElementReference _host;
    private IJSObjectReference? _module;
    private DotNetObjectReference<SqlEditor>? _selfRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _selfRef = DotNetObjectReference.Create(this);
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/editor.js");
        await _module.InvokeVoidAsync("init", _host, _selfRef, InitialValue, Theme.Current);
        Theme.Changed += OnThemeChanged;
    }

    private void OnThemeChanged() => _ = ApplyThemeAsync();

    private async Task ApplyThemeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("setTheme", Theme.Current);
            }
            catch (JSException)
            {
            }
        }
    }

    [JSInvokable]
    public Task OnRunRequested() => OnRun.InvokeAsync();

    [JSInvokable]
    public Task OnRunAllRequested() => OnRunAll.InvokeAsync();

    [JSInvokable]
    public Task OnContentChanged() => OnChanged.InvokeAsync();

    [JSInvokable]
    public async Task<IReadOnlyList<CompletionEntry>> GetCompletions(string text, int offset)
    {
        if (CompletionSource is null)
        {
            return [];
        }

        return await CompletionSource(text, offset);
    }

    public async Task<string> GetValueAsync() =>
        _module is null ? string.Empty : await _module.InvokeAsync<string>("getValue");

    public async Task SetValueAsync(string value)
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("setValue", value);
        }
    }

    public async Task<string> GetSelectedTextAsync() =>
        _module is null ? string.Empty : await _module.InvokeAsync<string>("getSelectedText");

    public async Task<int> GetCursorOffsetAsync() =>
        _module is null ? 0 : await _module.InvokeAsync<int>("getCursorOffset");

    public async ValueTask DisposeAsync()
    {
        Theme.Changed -= OnThemeChanged;
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose");
            }
            catch (JSException)
            {
            }

            await _module.DisposeAsync();
        }

        _selfRef?.Dispose();
    }
}
