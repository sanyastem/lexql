@page "/"
@using Lexql.Core.Results
@inject ConnectionSession Session

<div class="workspace">
    <aside class="sidebar">
        <section class="panel connect-panel">
            <h2>Connection</h2>
            <div class="fields">
                @foreach (var field in Session.Fields)
                {
                    <label class="field">
                        <span class="field-label">@field.Label@(field.Required ? " *" : null)</span>
                        <input class="field-input" type="@InputType(field)" @bind="_values[field.Key]" />
                    </label>
                }
            </div>

            <div class="actions">
                <button class="btn-connect" @onclick="ConnectAsync" disabled="@_busy">
                    @(_busy ? "Connecting…" : "Connect")
                </button>
                @if (Session.IsConnected)
                {
                    <button class="btn-disconnect" @onclick="DisconnectAsync" disabled="@_busy">Disconnect</button>
                }
            </div>

            @if (Session.Error is not null)
            {
                <p class="status error">@Session.Error</p>
            }
            else if (Session.IsConnected)
            {
                <p class="status ok">Connected to @Session.ConnectedTo</p>
            }
        </section>

        <section class="panel tree-panel">
            <h2>Objects</h2>
            @if (_roots is not null)
            {
                <ul class="tree-root">
                    @foreach (var root in _roots)
                    {
                        <ObjectTreeNode Node="root" Explorer="Session.Current!.ObjectExplorer" />
                    }
                </ul>
            }
            else if (Session.IsConnected)
            {
                <p class="status">Loading schema…</p>
            }
            else
            {
                <p class="status muted">Not connected.</p>
            }
        </section>
    </aside>

    <main class="editor-area">
        <section class="panel query-panel">
            <h2>Query</h2>
            <textarea class="sql-editor" @bind="_sql" @bind:event="oninput"
                      placeholder="SELECT 1;" spellcheck="false"></textarea>
            <div class="query-actions">
                <button class="btn-run" @onclick="RunAsync" disabled="@(_running || !Session.IsConnected)">
                    @(_running ? "Running…" : "Run")
                </button>
                <label class="limit">
                    Limit
                    <input class="limit-input" type="number" min="1" @bind="_rowLimit" />
                </label>
                @if (_status is not null)
                {
                    <span class="run-status">@_status</span>
                }
            </div>
            @if (_runError is not null)
            {
                <p class="status error">@_runError</p>
            }
        </section>

        <section class="panel result-panel">
            @if (_grid is not null)
            {
                <ResultGrid Model="_grid" />
            }
            else
            {
                <p class="status muted">Run a query to see results.</p>
            }
        </section>
    </main>
</div>

@code {
    private readonly Dictionary<string, string?> _values = new();
    private IReadOnlyList<DatabaseObjectNode>? _roots;
    private bool _busy;

    private string _sql = "SELECT 1;";
    private int _rowLimit = 1000;
    private bool _running;
    private string? _runError;
    private string? _status;
    private ResultGridModel? _grid;

    protected override void OnInitialized()
    {
        foreach (var field in Session.Fields)
        {
            _values[field.Key] = field.Default;
        }
    }

    private static string InputType(ConnectionField field) => field.Kind switch
    {
        ConnectionFieldKind.Password => "password",
        ConnectionFieldKind.Number => "number",
        _ => "text",
    };

    private async Task ConnectAsync()
    {
        _busy = true;
        _roots = null;
        try
        {
            var connected = await Session.ConnectAsync(_values, CancellationToken.None);
            if (connected && Session.Current is not null)
            {
                _roots = await Session.Current.ObjectExplorer.GetRootsAsync(CancellationToken.None);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DisconnectAsync()
    {
        await Session.DisconnectAsync();
        _roots = null;
        _grid = null;
        _status = null;
    }

    private async Task RunAsync()
    {
        if (Session.Current is null)
        {
            return;
        }

        _running = true;
        _runError = null;
        _status = null;
        _grid = null;
        try
        {
            var request = new QueryRequest(_sql, RowLimit: _rowLimit);
            var execution = await Session.Current.QueryExecutor.ExecuteAsync(request, CancellationToken.None);

            var resultSet = execution.ResultSets.FirstOrDefault();
            if (resultSet is not null)
            {
                _grid = await ResultGridBuilder.BuildAsync(resultSet, CancellationToken.None);
                _status = $"{_grid.Rows.Count} rows in {execution.Elapsed.TotalMilliseconds:F0} ms";
            }
            else
            {
                var affected = execution.AffectedCount ?? 0;
                _status = $"{affected} affected in {execution.Elapsed.TotalMilliseconds:F0} ms";
            }
        }
        catch (QueryExecutionException ex)
        {
            _runError = ex.Message;
        }
        finally
        {
            _running = false;
        }
    }
}
