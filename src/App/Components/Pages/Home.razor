@page "/"
@implements IDisposable
@using Lexql.Core.History
@inject WorkspaceState Workspace
@inject LocalizationService Localization
@inject IQueryHistoryStore History
@inject IJSRuntime JS

<div class="shell">
    <ConnectionsSidebar />
    <div class="col-resizer" data-resizer data-dir="x" data-min="220" data-max="640" data-store="lexql.sidebarW"></div>
    <QueryArea />
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        Workspace.Changed += OnChanged;
        Localization.Changed += OnChanged;
        try
        {
            await Localization.InitializeAsync();
            await History.InitializeAsync(CancellationToken.None);
            await Workspace.InitializeAsync();
            _ready = true;
        }
        catch (Exception ex)
        {
            CrashLog.Append("Home.OnInitializedAsync EXCEPTION: " + ex);
            throw;
        }
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private IJSObjectReference? _splitters;
    private bool _ready;
    private bool _splashHidden;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            _splitters ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/splitter.js");
            await _splitters.InvokeVoidAsync("init");

            if (_ready && !_splashHidden)
            {
                _splashHidden = true;
                await JS.InvokeVoidAsync("lexqlSplash.hide");
            }
        }
        catch (Exception)
        {
        }
    }

    public void Dispose()
    {
        Workspace.Changed -= OnChanged;
        Localization.Changed -= OnChanged;
    }
}
