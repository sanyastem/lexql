@page "/"
@implements IDisposable
@using Lexql.Core.History
@inject WorkspaceState Workspace
@inject LocalizationService Localization
@inject IQueryHistoryStore History

<div class="shell">
    <ConnectionsSidebar />
    <QueryArea />
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        Workspace.Changed += OnChanged;
        Localization.Changed += OnChanged;
        try
        {
            await Localization.InitializeAsync();
            await History.InitializeAsync(CancellationToken.None);
            await Workspace.InitializeAsync();
        }
        catch (Exception ex)
        {
            CrashLog.Append("Home.OnInitializedAsync EXCEPTION: " + ex);
            throw;
        }
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Workspace.Changed -= OnChanged;
        Localization.Changed -= OnChanged;
    }
}
