@inject WorkspaceState Workspace
@inject LocalizationService L
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (_open)
{
    <div class="modal-overlay palette-overlay" @onclick="Close">
        <div class="palette" @onclick:stopPropagation="true">
            <input @ref="_input" class="palette-input" placeholder="@L["palette.placeholder"]"
                   value="@_query" @oninput="OnInput" @onkeydown="OnKeyDown" />
            @if (_noConnection)
            {
                <p class="palette-empty">@L["status.notConnected"]</p>
            }
            else if (_loading)
            {
                <p class="palette-empty">@L["tree.loading"]</p>
            }
            else if (Matches.Count == 0)
            {
                <p class="palette-empty">@L["palette.empty"]</p>
            }
            else
            {
                <ul class="palette-list">
                    @{ var i = 0; }
                    @foreach (var item in Matches)
                    {
                        var index = i++;
                        <li class="palette-item @(index == _selected ? "active" : null)"
                            @onclick="() => OpenItem(item)">
                            <span class="tree-icon @(item.IsView ? null : "accent")">
                                <TreeIcon Kind="@(item.IsView ? "view" : "container")" />
                            </span>
                            <span class="palette-name">@item.Name</span>
                            <span class="palette-schema">@item.Schema</span>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
}

@code {
    private bool _open;
    private bool _loading;
    private bool _noConnection;
    private string _query = string.Empty;
    private int _selected;
    private ElementReference _input;
    private IReadOnlyList<ObjectIndexItem> _index = [];
    private DotNetObjectReference<CommandPalette>? _selfRef;
    private IJSObjectReference? _module;
    private bool _focusPending;

    private List<ObjectIndexItem> Matches =>
        (string.IsNullOrWhiteSpace(_query)
            ? _index
            : _index.Where(o => o.Name.Contains(_query, StringComparison.OrdinalIgnoreCase)
                                || o.Schema.Contains(_query, StringComparison.OrdinalIgnoreCase)))
        .Take(50)
        .ToList();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/palette.js");
            await _module.InvokeVoidAsync("register", _selfRef);
        }

        if (_focusPending)
        {
            _focusPending = false;
            try
            {
                await _input.FocusAsync();
            }
            catch (Exception)
            {
            }
        }
    }

    [JSInvokable]
    public async Task Open()
    {
        _open = true;
        _query = string.Empty;
        _selected = 0;
        _focusPending = true;

        if (Workspace.ActiveConnectionId is not { } connectionId)
        {
            _noConnection = true;
            _index = [];
            StateHasChanged();
            return;
        }

        _noConnection = false;
        _loading = true;
        StateHasChanged();

        _index = await Workspace.GetObjectIndexAsync(connectionId, CancellationToken.None);
        _loading = false;
        StateHasChanged();
    }

    private void Close() => _open = false;

    private void OnInput(ChangeEventArgs e)
    {
        _query = e.Value?.ToString() ?? string.Empty;
        _selected = 0;
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        var matches = Matches;
        switch (e.Key)
        {
            case "Escape":
                Close();
                break;
            case "ArrowDown":
                _selected = matches.Count == 0 ? 0 : (_selected + 1) % matches.Count;
                break;
            case "ArrowUp":
                _selected = matches.Count == 0 ? 0 : (_selected - 1 + matches.Count) % matches.Count;
                break;
            case "Enter":
                if (_selected >= 0 && _selected < matches.Count)
                {
                    OpenItem(matches[_selected]);
                }

                break;
        }
    }

    private void OpenItem(ObjectIndexItem item)
    {
        if (Workspace.ActiveConnectionId is { } connectionId)
        {
            Workspace.OpenTableData(connectionId, item.Schema, item.Name);
        }

        Close();
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("unregister");
            }
            catch (JSException)
            {
            }

            await _module.DisposeAsync();
        }

        _selfRef?.Dispose();
    }
}
