@switch (Kind)
{
    case "server":
        <svg viewBox="0 0 16 16" aria-hidden="true">
            <rect x="2.5" y="2.5" width="11" height="4.5" rx="1" />
            <rect x="2.5" y="9" width="11" height="4.5" rx="1" />
            <circle cx="4.7" cy="4.75" r="0.7" fill="currentColor" stroke="none" />
            <circle cx="4.7" cy="11.25" r="0.7" fill="currentColor" stroke="none" />
        </svg>
        break;

    case "namespace":
        <svg viewBox="0 0 16 16" aria-hidden="true">
            <ellipse cx="8" cy="3.6" rx="5" ry="2.1" />
            <path d="M3 3.6 V12.4 C3 13.6 5.2 14.4 8 14.4 C10.8 14.4 13 13.6 13 12.4 V3.6" />
            <path d="M3 8 C3 9.2 5.2 10 8 10 C10.8 10 13 9.2 13 8" />
        </svg>
        break;

    case "container":
        <svg viewBox="0 0 16 16" aria-hidden="true">
            <rect x="2.5" y="3" width="11" height="10" rx="1.2" />
            <line x1="2.5" y1="6.4" x2="13.5" y2="6.4" />
            <line x1="8" y1="6.4" x2="8" y2="13" />
        </svg>
        break;

    case "view":
        <svg viewBox="0 0 16 16" aria-hidden="true">
            <path d="M1.6 8 C3.6 4.6 12.4 4.6 14.4 8 C12.4 11.4 3.6 11.4 1.6 8 Z" />
            <circle cx="8" cy="8" r="1.9" />
        </svg>
        break;

    case "routine":
        <svg viewBox="0 0 16 16" aria-hidden="true">
            <path d="M6.2 3 C4.4 3 5 7 3.2 8 C5 9 4.4 13 6.2 13" />
            <path d="M9.8 3 C11.6 3 11 7 12.8 8 C11 9 11.6 13 9.8 13" />
        </svg>
        break;

    case "trigger":
        <svg viewBox="0 0 16 16" aria-hidden="true">
            <path d="M9 1.5 L4 9 H7.3 L6.4 14.5 L12 6.5 H8.4 Z" fill="currentColor" stroke="none" />
        </svg>
        break;

    case "field":
        <svg viewBox="0 0 16 16" aria-hidden="true">
            <rect x="6.4" y="2.6" width="3.2" height="10.8" rx="1.4" />
        </svg>
        break;

    default:
        <svg viewBox="0 0 16 16" aria-hidden="true">
            <path d="M2 4.5 H6.2 L7.7 6 H14 V12.5 H2 Z" />
        </svg>
        break;
}

@code {
    [Parameter, EditorRequired]
    public string Kind { get; set; } = "folder";
}
