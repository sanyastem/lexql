<li class="tree-node">
    <span class="tree-label @(Node.HasChildren ? "expandable" : null)" @onclick="ToggleAsync">
        <span class="tree-chevron">@(Node.HasChildren ? (_expanded ? "▾" : "▸") : null)</span>
        <span class="tree-icon @(IsAccent ? "accent" : null)"><TreeIcon Kind="@IconName" /></span>
        <span class="tree-name">@Node.Name</span>
        @if (_loading)
        {
            <span class="tree-loading">…</span>
        }
    </span>

    @if (_expanded && _children is not null)
    {
        <ul class="tree-children">
            @foreach (var child in _children)
            {
                <ObjectTreeNode Node="child" Explorer="Explorer" />
            }
        </ul>
    }
</li>

@code {
    [Parameter, EditorRequired]
    public DatabaseObjectNode Node { get; set; } = default!;

    [Parameter, EditorRequired]
    public IObjectExplorer Explorer { get; set; } = default!;

    private bool _expanded;
    private bool _loading;
    private IReadOnlyList<DatabaseObjectNode>? _children;

    private string IconName => Node.Kind switch
    {
        DatabaseObjectKind.Namespace => "namespace",
        DatabaseObjectKind.Container => "container",
        DatabaseObjectKind.View => "view",
        DatabaseObjectKind.Routine => "routine",
        DatabaseObjectKind.Trigger => "trigger",
        DatabaseObjectKind.Field => "field",
        _ => "folder",
    };

    private bool IsAccent => Node.Kind is DatabaseObjectKind.Namespace or DatabaseObjectKind.Container;

    private async Task ToggleAsync()
    {
        if (!Node.HasChildren || _loading)
        {
            return;
        }

        _expanded = !_expanded;
        if (_expanded && _children is null)
        {
            _loading = true;
            try
            {
                _children = await Explorer.GetChildrenAsync(Node, CancellationToken.None);
            }
            finally
            {
                _loading = false;
            }
        }
    }
}
