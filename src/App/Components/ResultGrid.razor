@using Lexql.Core.Results
@inject IJSRuntime JS
@implements IAsyncDisposable

<div @ref="_element" class="result-grid"></div>

@code {
    [Parameter, EditorRequired]
    public ResultGridModel Model { get; set; } = default!;

    [Parameter]
    public bool Editable { get; set; }

    [Parameter]
    public IReadOnlyList<string> KeyColumns { get; set; } = [];

    [Parameter]
    public EventCallback<string?> OnCellSelected { get; set; }

    [Parameter]
    public bool HasMore { get; set; }

    [Parameter]
    public EventCallback OnLoadMore { get; set; }

    private ElementReference _element;
    private IJSObjectReference? _module;
    private DotNetObjectReference<ResultGrid>? _selfRef;
    private ResultGridModel? _renderedModel;
    private bool _appliedHasMore;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/grid.js");
        _selfRef ??= DotNetObjectReference.Create(this);

        if (!ReferenceEquals(Model, _renderedModel))
        {
            _renderedModel = Model;
            _appliedHasMore = HasMore;
            var columns = Model.Columns.Select(c => new { name = c.Name, type = c.Type, numeric = c.Numeric });
            var options = new { editable = Editable, keyColumns = KeyColumns, dotnetRef = _selfRef, hasMore = HasMore };
            await _module.InvokeVoidAsync("renderGrid", _element, columns, Model.Rows, options);
        }
        else if (_appliedHasMore != HasMore)
        {
            _appliedHasMore = HasMore;
            await _module.InvokeVoidAsync("setHasMore", _element, HasMore);
        }
    }

    [JSInvokable]
    public Task OnCellClicked(string? value) => OnCellSelected.InvokeAsync(value);

    [JSInvokable]
    public Task OnLoadMoreRequested() => OnLoadMore.InvokeAsync();

    public async Task AppendRowsAsync(IReadOnlyList<object?[]> rows)
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("appendRows", _element, rows);
        }
    }

    public async Task<GridChangeSet?> GetChangesAsync() =>
        _module is null ? null : await _module.InvokeAsync<GridChangeSet>("getChanges", _element);

    public async Task AddRowAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("addRow", _element);
        }
    }

    public async Task DeleteSelectedAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("deleteSelected", _element);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            await _module.DisposeAsync();
        }

        _selfRef?.Dispose();
    }
}
